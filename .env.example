# Steganography System - Environment Configuration Template
# Copy this file to .env and provide your actual values.
# NEVER commit .env to version control!

# Application Environment ('production' on Render, 'local' for dev)
APP_ENV=production
APP_URL=https://your-app-name.onrender.com
# Set to 0 only for local/no-email deployments; unverified addresses can then register.
EMAIL_VERIFICATION_REQUIRED=1

# Database Connection (Aiven MySQL 8.4)
DB_HOST=mysql-xxxxxxxx-your-service.aivencloud.com
DB_PORT=3306
DB_NAME=Steganography
DB_USER=avnadmin
DB_PASS=your_database_password_here

# Mailer Configuration
# Options: 'brevo' (HTTPS cURL for production), 'smtp' (PHPMailer for dev), 'log' (local dev only)
MAIL_PROVIDER=brevo
MAIL_FROM=security@your-domain.com
MAIL_FROM_NAME="Steganography Security"

# Brevo API Key (Required when MAIL_PROVIDER=brevo)
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxxxxxxxxxxxxx

# SMTP Configuration (Used only when MAIL_PROVIDER=smtp in local dev)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Image Resolution Limit (Total pixels = width * height)
# Default is 9000000 (~3000x3000). Set lower (e.g. 4000000) for strict low-memory constraints.
MAX_IMAGE_PIXELS=9000000

# Secret Payload Size Limit in KB (Default 200 KB to stay below the 300 MB memory target at 9 MP)
PAYLOAD_MAX_KB=200

# Local development example (replace the database placeholders for your local MySQL)
# APP_ENV=local
# APP_URL=http://127.0.0.1:8000
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=steganography_local
# DB_USER=your_local_mysql_user
# MAIL_PROVIDER=log
# EMAIL_VERIFICATION_REQUIRED=0

# Diagnostic / IP Debug Token (Optional, delete or disable after verification)
# When set, allows access to /ip_debug.php?token=YOUR_TOKEN
IP_DEBUG_TOKEN=
